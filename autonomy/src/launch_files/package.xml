<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>launch_files</name>
  <version>1.0.0</version>
  <description>A package to hold the launch, config, and other similar files.</description>
  <maintainer email="ljlamoreaux15@gmail.com">Landon Lamoreaux</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>nav2_simple_commander</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>navigation2</exec_depend>
  <!-- <exec_depend>xacro</exec_depend> -->
  
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros gazebo_model_path="${prefix}/../"/>
  </export>
</package>
