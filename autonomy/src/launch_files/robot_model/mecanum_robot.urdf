<?xml version="1.0"?>
<!--
  Robot dimensions:
    chassis:       0.80 m x 0.60 m x 0.20 m
    wheel radius:  0.12 m
    wheel width:   0.08 m
    wheel centers: +/-0.32 m X, +/-0.27 m Y

  This uses Gazebo Sim's built-in MecanumDrive system.
  The Gazebo command topic is "/cmd_vel".
-->

<robot name="basic_mecanum" xmlns:gz="http://gazebosim.org/schema">

  <!-- Robot footprint -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.22" rpy="0 0 0"/>
  </joint>

  <!-- Main chassis -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="12.0"/>
      <inertia
        ixx="0.0625"
        ixy="0"
        ixz="0"
        iyy="0.2125"
        iyz="0"
        izz="0.25"/>
    </inertial>

    <visual name="chassis_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.80 0.60 0.20"/>
      </geometry>
      <material name="chassis_material">
        <color rgba="0.185 0.422 0.755 1.0"/>
      </material>
    </visual>

    <collision name="chassis_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.80 0.60 0.20"/>
      </geometry>
    </collision>
  </link>

  <!-- Front-left wheel -->
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0.35 0.27 -0.10" rpy="-1.5707963 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="10000" velocity="10"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <link name="front_left_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia
        ixx="0.145833"
        ixy="0"
        ixz="0"
        iyy="0.145833"
        iyz="0"
        izz="0.125"/>
    </inertial>

    <visual name="front_left_wheel_visual">
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <mesh filename="package://launch_files/meshes/mecanum_wheel_left.STL" scale="0.002 0.002 0.002"/>
      </geometry>
      <material name="wheel_material">
        <color rgba="0.20 0.40 0.85 1.0"/>
      </material>
    </visual>

    <collision name="front_left_wheel_collision">
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <sphere radius="0.1"/>
      </geometry>
    </collision>
  </link>

  <!-- Front-right wheel -->
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0.35 -0.27 -0.10" rpy="1.5707963 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit effort="10000" velocity="10"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <link name="front_right_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia
        ixx="0.145833"
        ixy="0"
        ixz="0"
        iyy="0.145833"
        iyz="0"
        izz="0.125"/>
    </inertial>

    <visual name="front_right_wheel_visual">
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <mesh filename="package://launch_files/meshes/mecanum_wheel_right.STL" scale="0.002 0.002 0.002"/>
      </geometry>
      <material name="wheel_material"/>
    </visual>

    <collision name="front_right_wheel_collision">
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <sphere radius="0.1"/>
      </geometry>
    </collision>
  </link>

  <!-- Rear-left wheel -->
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-0.35 0.27 -0.10" rpy="-1.5707963 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="10000" velocity="10"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <link name="rear_left_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia
        ixx="0.145833"
        ixy="0"
        ixz="0"
        iyy="0.145833"
        iyz="0"
        izz="0.125"/>
    </inertial>

    <visual name="rear_left_wheel_visual">
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <mesh filename="package://launch_files/meshes/mecanum_wheel_right.STL" scale="0.002 0.002 0.002"/>
      </geometry>
      <material name="wheel_material"/>
    </visual>

    <collision name="rear_left_wheel_collision">
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <sphere radius="0.1"/>
      </geometry>
    </collision>
  </link>

  <!-- Rear-right wheel -->
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-0.35 -0.27 -0.10" rpy="1.5707963 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit effort="10000" velocity="10"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <link name="rear_right_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia
        ixx="0.145833"
        ixy="0"
        ixz="0"
        iyy="0.145833"
        iyz="0"
        izz="0.125"/>
    </inertial>

    <visual name="rear_right_wheel_visual">
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <mesh filename="package://launch_files/meshes/mecanum_wheel_left.STL" scale="0.002 0.002 0.002"/>
      </geometry>
      <material name="wheel_material"/>
    </visual>

    <collision name="rear_right_wheel_collision">
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <sphere radius="0.1"/>
      </geometry>
    </collision>
  </link>

  <!-- =========================
      Front-top simulated 2D lidar
      base_link is centered in the chassis. +X is the robot front.
      The sensor origin is above the chassis top (z = 0.10 m).
      Gazebo publishes /lidar/scan; bridge it into ROS 2 with ros_gz_bridge.
      ========================= -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="lidar_link"/>
    <origin xyz="0.28 0 0.36" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.001" ixy="0" ixz="0"
               iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual name="lidar_housing_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.045" length="0.06"/></geometry>
      <material name="lidar_housing_material">
        <color rgba="0.85 0.25 0.25 1"/>
      </material>
    </visual>
    <collision name="lidar_housing_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.045" length="0.06"/></geometry>
    </collision>
  </link>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <frame_id>lidar_link</frame_id>
      <!-- <pose>0 0 0.035 0 0 0</pose> -->
      <topic>/lidar/scan</topic>
      <update_rate>10</update_rate>
      <visualize>true</visualize>
      <always_on>true</always_on>
      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.05</min>
          <max>20.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <!-- Attach IMU to the robot chassis -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
  </joint>

    <!-- IMU frame -->
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.04 0.04 0.02"/>
      </geometry>
      <material name="imu_material">
        <color rgba="0.2 0.7 0.3 1.0"/>
      </material>
    </visual>
  </link>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
      <topic>/imu/data</topic>
      <frame_id>imu_link</frame_id>

      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </z>
        </angular_velocity>

        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.002</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.002</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.002</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- ==========================================================
       Gazebo friction
       The fdir1 directions approximate the 45-degree mecanum
       roller contact direction.
       ========================================================== -->

  <gazebo reference="base_link">
    <mu1>0.000002</mu1>
    <mu2>0.000002</mu2>
  </gazebo>

  <gazebo reference="front_left_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.5</mu>
            <mu2>0.0</mu2>
            <fdir1 gz:expressed_in="base_footprint">1 -1 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <gazebo reference="front_right_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.5</mu>
            <mu2>0.0</mu2>
            <fdir1 gz:expressed_in="base_footprint">1 1 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <gazebo reference="rear_left_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.5</mu>
            <mu2>0.0</mu2>
            <fdir1 gz:expressed_in="base_footprint">1 1 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <gazebo reference="rear_right_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.5</mu>
            <mu2>0.0</mu2>
            <fdir1 gz:expressed_in="base_footprint">1 -1 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <!-- Gazebo Sim Mecanum Drive -->
  <gazebo>
    <plugin
      filename="gz-sim-mecanum-drive-system"
      name="gz::sim::systems::MecanumDrive">

      <topic>cmd_vel</topic>

      <front_left_joint>front_left_wheel_joint</front_left_joint>
      <front_right_joint>front_right_wheel_joint</front_right_joint>
      <back_left_joint>rear_left_wheel_joint</back_left_joint>
      <back_right_joint>rear_right_wheel_joint</back_right_joint>

      <wheel_separation>0.54</wheel_separation>
      <wheelbase>0.7</wheelbase>
      <wheel_radius>0.1</wheel_radius>

      <min_acceleration>-5.0</min_acceleration>
      <max_acceleration>5.0</max_acceleration>
      <min_angular_acceleration>-6</min_angular_acceleration>
      <max_angular_acceleration>6</max_angular_acceleration>

      <odom_topic>/odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <!-- Publish Odometry Data. -->
    <!-- <plugin name="gz::sim::systems::OdometryPublisher" filename="gz-sim-odometry-publisher-system">
      <odom_topic>odom</odom_topic>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <publish_tf>true</publish_tf>
      <tf_topic>tf</tf_topic>
      <odom_publish_frequency>30</odom_publish_frequency>
      <xyz_offset>0 0 0</xyz_offset>
      <rpy_offset>0 0 0</rpy_offset>
    </plugin> -->

    <!-- Publish wheel joint states inside Gazebo. -->
    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

</robot>
